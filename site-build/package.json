{
  "name": "site-build",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "latest",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "astro": "^7.3.5",
    "unist-util-visit": "^5.1.0"
  },
  "scripts": {
    "build": "astro build",
    "preview": "astro preview",
    "css:check": "bun check-css.mjs",
    "lint": "biome check src/lib/ src/plugins/ public/assets/ check-css.mjs check-links.mjs eslint.config.mjs && bun check-css.mjs && bun check-links.mjs && prettier --check 'src/**/*.astro' && eslint 'src/**/*.astro'",
    "links:check": "bun check-links.mjs"
