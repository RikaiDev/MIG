{
	"name": "mig-site",
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.1",
		"astro": "^7.0.0",
		"unist-util-visit": "^5.1.0"
	},
	"private": true,
	"scripts": {
		"prebuild": "rm -rf node_modules/.vite node_modules/.astro .astro",
		"build": "astro build && bun make-index.mjs",
		"preview": "astro preview",
		"css:build": "bun src/styles/build-css.mjs",
		"css:check": "bun check-css.mjs",
		"lint": "biome check src/styles/ src/plugins/ public/assets/ check-css.mjs && bun check-css.mjs && prettier --check 'src/**/*.astro'"
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.0"
	}
}
