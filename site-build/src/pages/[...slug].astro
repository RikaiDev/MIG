---
import { getCollection, render } from "astro:content";
// biome-ignore lint/correctness/noUnusedImports: Biome cannot see Astro template usage; binding is consumed in markup below
import Layout from "../layouts/Layout.astro";

export async function getStaticPaths() {
	const pages = await getCollection("docs");
	return pages
		.filter((p) => p.id.replace(/\.md$/, "") !== "index")
		.map((p) => ({
			params: { slug: p.id.replace(/\.md$/, "") },
			props: { entry: p },
		}));
}

const { entry } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Biome cannot see Astro template usage; binding is consumed in markup below
const { Content, headings } = await render(entry);
// biome-ignore lint/correctness/noUnusedVariables: Biome cannot see Astro template usage; binding is consumed in markup below
const slug = entry.id.replace(/\.md$/, "");
---

<Layout
	title={entry.data.title}
	description={entry.data.description}
	hero={slug === "index"}
	active={slug}
	headings={headings}
>
	<Content />
</Layout>
