---
import { getEntry, render } from "astro:content";
// biome-ignore lint/correctness/noUnusedImports: Biome cannot see Astro template usage; binding is consumed in markup below
import Layout from "../layouts/Layout.astro";

const entry = await getEntry("docs", "index");
if (!entry) throw new Error("docs/index not found");
// biome-ignore lint/correctness/noUnusedVariables: Biome cannot see Astro template usage; binding is consumed in markup below
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  hero={true}
  active="index"
>
  <Content />
</Layout>
