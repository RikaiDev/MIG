---
import { getCollection, render } from "astro:content";
import Docs from "../../layouts/Docs.astro";
import { buildNav, otherLangHref } from "../../lib/docs-nav";

export async function getStaticPaths() {
  const pages = await getCollection("docsZh");
  return pages
    .filter((p) => p.id.replace(/\.md$/, "") !== "index")
    .map((p) => ({
      params: { slug: p.id.replace(/\.md$/, "") },
      props: { id: p.id },
    }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { id } = Astro.props;
const pages = await getCollection("docsZh");
const entry = pages.find((p) => p.id === id);
if (!entry) throw new Error(`missing zh doc: ${id}`);
const { Content, headings } = await render(entry);
const { nav, prev, next } = buildNav(
  base,
  "zh",
  pages.map((p) => ({
    id: p.id,
    title: p.data.title,
    nav: p.data.nav,
    order: p.data.order,
    group: p.data.group ?? "指南",
  })),
  id,
);
---

<Docs
  lang="zh"
  title={entry.data.title}
  description={entry.data.description}
  nav={nav}
  prev={prev}
  next={next}
  headings={headings}
  otherLangHref={otherLangHref(base, "zh", id)}
>
  <Content />
</Docs>
